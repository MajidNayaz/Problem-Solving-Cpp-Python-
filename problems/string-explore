string LowerCase_Convert(string St){
    string s_lower;
    for (char s : St){
        s_lower.push_back(tolower(s));
    }
    return s_lower;
}

string RemoveNonAlNum(string St){
    string cleaned;
    for (char s : St){
        if (isalnum(s)){
            cleaned.push_back(s);
        }
    }
    return cleaned;
}




